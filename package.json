{
  "name": "daegu-sarang-church",
  "version": "0.1.0",
  "private": true,
  "description": "구세군 대구사랑교회 홈페이지",
  "scripts": {
    "dev": "npm --prefix site run dev",
    "build": "node scripts/strip-exif.mjs && node scripts/resize-photos.mjs && npm --prefix site install --no-audit --no-fund && npm --prefix site run build",
    "preview": "npm --prefix site run preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "piexifjs": "^1.0.6",
    "sharp": "^0.35.3",
    "wrangler": "^4.114.0"
  }
}

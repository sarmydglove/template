---
import type { HeroPhoto } from "../data/church";

/**
 * 히어로 배경 전체화면 크로스페이드 슬라이드.
 *
 * 사진이 저절로 넘어가고, 왼쪽 아래 번호(01 02 03…)를 누르면
 * 원하는 사진을 바로 볼 수 있습니다.
 *
 * 사진마다 object-position 을 다르게 줍니다. 히어로는 가로로 넓고 납작해서
 * 사진의 위아래가 잘리는데, 어느 부분을 남길지 정해 둔 값입니다.
 * (관리자 화면의 '배경 사진 위치 맞추기' 도구에서 끌어서 정합니다)
 */
interface Props {
  photos: HeroPhoto[];
  alt: string;
}
const { photos, alt } = Astro.props;
const many = photos.length > 1;
---

<div class="absolute inset-0 h-full w-full" data-hero-slideshow>
  {
    photos.map((photo, i) => (
      <img
        src={photo.src}
        alt={i === 0 ? alt : ""}
        aria-hidden={i === 0 ? undefined : "true"}
        loading={i === 0 ? "eager" : "lazy"}
        fetchpriority={i === 0 ? "high" : undefined}
        class="hero-slide absolute inset-0 h-full w-full object-cover"
        style={[
          `opacity: ${i === 0 ? 1 : 0}`,
          `object-position: ${photo.posX}% ${photo.posY}%`,
          // 확대할 때 고른 지점이 그대로 남도록, 기준점을 같은 자리에 둡니다
          `transform: scale(${photo.zoom / 100})`,
          `transform-origin: ${photo.posX}% ${photo.posY}%`,
        ].join("; ")}
        data-hero-slide
      />
    ))
  }

  {
    many && (
      /*
        번호 버튼. 어두운 그라데이션(scrim)보다 위에 보여야 하므로 z-20 을 줍니다.
        (그라데이션은 이 요소의 다음 형제라서 z-index 가 없으면 위를 덮습니다)
      */
      <div class="absolute inset-x-0 bottom-0 z-20">
        <div class="mx-auto flex max-w-6xl gap-4 px-5 pb-6 sm:pb-8">
          {photos.map((_, i) => (
            <button
              type="button"
              data-hero-dot
              aria-label={`${i + 1}번째 사진 보기`}
              aria-current={i === 0 ? "true" : undefined}
              class="hero-dot px-1 py-2 text-xs font-bold tracking-wider tabular-nums transition-colors"
            >
              {String(i + 1).padStart(2, "0")}
            </button>
          ))}
        </div>
      </div>
    )
  }
</div>

<style>
  .hero-slide {
    transition: opacity 1.8s ease-in-out;
  }

  /* 현재 사진이 아닌 번호는 흐리게 */
  .hero-dot {
    color: rgb(255 255 255 / 0.45);
  }
  .hero-dot:hover,
  .hero-dot:focus-visible {
    color: rgb(255 255 255 / 0.8);
  }
  .hero-dot[aria-current="true"] {
    color: #fff;
  }
</style>

<script>
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  document.querySelectorAll("[data-hero-slideshow]").forEach((container) => {
    const slides = Array.from(
      container.querySelectorAll<HTMLElement>("[data-hero-slide]"),
    );
    const dots = Array.from(
      container.querySelectorAll<HTMLElement>("[data-hero-dot]"),
    );
    if (slides.length < 2) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    function go(next: number) {
      if (next === current) return;
      slides[current].style.opacity = "0";
      slides[next].style.opacity = "1";
      dots[current]?.removeAttribute("aria-current");
      dots[next]?.setAttribute("aria-current", "true");
      current = next;
    }

    function start() {
      // 움직임을 줄이도록 설정한 분에게는 저절로 넘기지 않습니다.
      // (번호를 눌러서 보는 것은 그대로 됩니다)
      if (reduceMotion) return;
      timer = setInterval(() => go((current + 1) % slides.length), 5000);
    }

    function restart() {
      if (timer) clearInterval(timer);
      start();
    }

    function select(i: number) {
      go(i);
      restart(); // 직접 고른 뒤에는 바로 안 넘어가도록 시간을 다시 셉니다
    }

    dots.forEach((dot, i) => {
      // 마우스를 올리기만 해도 바뀝니다 (누르지 않아도 됩니다)
      dot.addEventListener("mouseenter", () => select(i));
      // 휴대폰에서는 올리는 동작이 없으므로 눌러서 고릅니다
      dot.addEventListener("click", () => select(i));
      // 키보드로 이동할 때도 같이 바뀌도록
      dot.addEventListener("focus", () => select(i));
    });

    start();
  });
</script>

---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  /** 있으면 머리글을 이 사진을 배경으로 한 어두운 판으로 바꿉니다 */
  backgroundPhoto?: string;
}
const { eyebrow, title, description, backgroundPhoto } = Astro.props;
---

{
  backgroundPhoto ? (
    <section class="relative isolate overflow-hidden bg-sa-navy">
      <img
        src={backgroundPhoto}
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="hero-scrim absolute inset-0" aria-hidden="true" />
      <div class="relative mx-auto max-w-6xl px-5 py-24 md:py-32">
        {eyebrow && (
          <p class="text-sm font-bold tracking-[0.2em] text-sa-gold">
            {eyebrow}
          </p>
        )}
        <h1 class="mt-5 text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
          {title}
        </h1>
        {description && (
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/80">
            {description}
          </p>
        )}
      </div>
    </section>
  ) : (
    <section class="border-b border-sa-line bg-sa-surface">
      <div class="mx-auto max-w-6xl px-5 py-16 md:py-20">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="mt-4 text-3xl font-bold sm:text-4xl lg:text-5xl">{title}</h1>
        {description && (
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-sa-muted">
            {description}
          </p>
        )}
      </div>
    </section>
  )
}

---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { church } from "../../data/church";

const galleries = (
  await getCollection("galleries", ({ data }) => data.published)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(
    d.getDate(),
  ).padStart(2, "0")}`;
---

<Base
  title="사진"
  description={`${church.name} 사진 갤러리 — 예배와 행사의 순간들을 나눕니다.`}
>
  <PageHeader
    eyebrow="사진"
    title="함께한 순간들"
    description="예배와 행사에서 나눈 시간을 사진으로 전해드립니다."
  />

  <section class="py-20 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      {
        galleries.length > 0 ? (
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {galleries.map((g) => (
              <a
                href={`/gallery/${g.id}`}
                class="group block overflow-hidden rounded-xl border border-sa-line bg-white transition-shadow hover:shadow-lg"
              >
                <div class="aspect-[4/3] overflow-hidden bg-sa-navy/10">
                  <img
                    src={g.data.photos[0]}
                    alt=""
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <div class="p-5">
                  <p class="text-xs font-bold text-sa-muted">{fmt(g.data.date)}</p>
                  <h2 class="mt-2 font-bold leading-snug group-hover:text-sa-red">
                    {g.data.title}
                  </h2>
                  <p class="mt-1.5 text-sm text-sa-muted">
                    사진 {g.data.photos.length}장
                  </p>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="rounded-xl border border-sa-line bg-sa-surface p-10 text-center text-sa-muted">
            아직 등록된 사진이 없습니다.
          </p>
        )
      }
    </div>
  </section>
</Base>

---
/**
 * 새 성전 둘러보기 — 실시설계 도면으로 만든 3D 모델을 페이지 안에 띄웁니다.
 * 모델은 별도 사이트(Cloudflare Pages)에 있고, 여기서는 ?embed=1 로 불러
 * 모델 쪽 이름판을 숨깁니다. 안내 문장·주소는 관리자 화면
 * '사이트 설정 > 새 성전 둘러보기'(settings/tour.json)에서 바꿉니다.
 */
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { church } from "../data/church";
import tourSettings from "../data/settings/tour.json";

const DEFAULT_URL = "https://daegu-sarang-walkthrough.pages.dev/";
const raw = (tourSettings as { url?: string }).url?.trim();
const base = raw && /^https:\/\//.test(raw) ? raw : DEFAULT_URL;
const embedUrl = new URL(base);
embedUrl.searchParams.set("embed", "1");
const intro =
  (tourSettings as { intro?: string }).intro ||
  "신축 중인 새 성전을 미리 걸어서 둘러보세요.";
const note = (tourSettings as { note?: string }).note || "";

const tips = [
  { title: "외관 보기", desc: "끌어서 돌리고, 두 손가락이나 휠로 확대합니다." },
  { title: "걸어서 보기", desc: "왼쪽 목록에서 공간을 고르면 그 자리에 섭니다. 화면을 끌어 둘러보고 방향 버튼으로 걷습니다." },
  { title: "층별 보기", desc: "층을 위아래로 펼쳐 공간 이름을 보여 줍니다. 이름을 누르면 그 공간으로 들어갑니다." },
];
---

<Base
  title="새 성전 둘러보기"
  description={`${church.name} 새 성전을 3D로 미리 둘러보세요.`}
>
  <PageHeader
    eyebrow="새 성전"
    title="새 성전 3D 둘러보기"
    description={intro}
  />

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-5">
      <div class="overflow-hidden rounded-lg border border-sa-line bg-sa-line/40 shadow-sm">
        <iframe
          src={embedUrl.toString()}
          title={`${church.name} 새 성전 3D 모델`}
          class="block h-[78vh] min-h-[480px] max-h-[860px] w-full"
          loading="lazy"
          allow="fullscreen; xr-spatial-tracking"
          allowfullscreen
        ></iframe>
      </div>

      <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
        {note && <p class="max-w-3xl text-sm text-sa-muted">{note}</p>}
        <a
          href={base}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-md bg-sa-red px-5 py-3 text-sm font-bold text-white hover:opacity-90"
        >
          새 창에서 크게 보기
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {
          tips.map((t) => (
            <li class="border-l-3 border-sa-red pl-5">
              <p class="font-bold">{t.title}</p>
              <p class="mt-1.5 text-sm text-sa-muted">{t.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
